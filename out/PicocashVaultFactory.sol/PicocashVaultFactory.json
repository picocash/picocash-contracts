e\",\"type\":\"string\"},{\"indexed\":false,\"internalType\":\"string\",\"name\":\"mintUrl\",\"type\":\"string\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"rotationTimelock\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint16\",\"name\":\"publishThresholdBps\",\"type\":\"uint16\"},{\"indexed\":false,\"internalType\":\"uint64\",\"name\":\"publishIntervalBlocks\",\"type\":\"uint64\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"maxMeltFee\",\"type\":\"uint256\"}],\"name\":\"VaultDeployed\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"operator\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"rotationTimelock\",\"type\":\"uint256\"},{\"internalType\":\"uint16\",\"name\":\"publishThresholdBps\",\"type\":\"uint16\"},{\"internalType\":\"uint64\",\"name\":\"publishIntervalBlocks\",\"type\":\"uint64\"},{\"internalType\":\"uint256\",\"name\":\"maxMeltFee\",\"type\":\"uint256\"},{\"internalType\":\"string\",\"name\":\"name\",\"type\":\"string\"},{\"internalType\":\"string\",\"name\":\"mintUrl\",\"type\":\"string\"}],\"name\":\"deployVault\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"vault\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"vault\",\"type\":\"address\"}],\"name\":\"isVault\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"vaultCount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"name\":\"vaults\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"title\":\"PicocashVaultFactory \\u2014 canonical deployer & registry for picocash vaults\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"deployVault(address,address,uint256,uint16,uint64,uint256,string,string)\":{\"notice\":\"Deploy a vault. The caller pays gas; `operator` (the mint's         key) controls the vault from birth \\u2014 the factory and the caller         retain nothing. The publication policy (at least one rule) is a         deploy-time commitment: `publishThresholdBps` (publish when the         backing drifts more than X bps) and/or `publishIntervalBlocks`         (publish at least every X blocks).\"},\"isVault(address)\":{\"notice\":\"True iff the address was deployed by this factory.\"},\"vaults(uint256)\":{\"notice\":\"Every vault ever deployed, in order.\"}},\"notice\":\"A mint operator (or the customer entity that will hold custody) calls         `deployVault` to create their vault. The factory gives the ecosystem         two things:         1. **Provenance**: `isVault(addr)` proves a vault runs exactly this            audited bytecode \\u2014 never-pausable withdrawals, one payout per            meltId, timelocked rotation. Services allowlisting mints can            check it in one call instead of verifying source per vault.         2. **Discovery**: `VaultDeployed` events + the `vaults` array            enumerate every picocash vault on this chain, and each vault's            `info()` points to its mint's HTTP API.         The factory is permissionless and holds ZERO authority over         deployed vaults \\u2014 it is a birth certificate, not a parent. There is         no owner, no upgrade path, and no function that touches a vault         after deployment.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/PicocashVaultFactory.sol\":\"PicocashVaultFactory\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"],\"viaIR\":true},\"sources\":{\"src/PicocashVault.sol\":{\"keccak256\":\"0xbff0c74a5147ff94a63a64bd6faf2199a64409ccc16ebda4d3cd31fb02ad3413\",\"license\":\"Apache-2.0\",\"urls\":[\"bzz-raw://6ee93bedf1fdd5bf898f82665b1d2654aca3afa937d761e24720089551ce027e\",\"dweb:/ipfs/QmfCyFLdAFGQyQqqXLDT3bUHgFBArBfEKaGtspBv9eBgDm\"]},\"src/PicocashVaultFactory.sol\":{\"keccak256\":\"0x8ff115fe30e1f4282f3afa20a7dbc55cbf9dc4065f1e73d8e6e1d78cf6155f6c\",\"license\":\"Apache-2.0\",\"urls\":[\"bzz-raw://5ecf84f664195a9332cec619462f131ab05e57e674e6399f0866d83b8cecd38a\",\"dweb:/ipfs/QmW2nuNxHYUV6j7L2FJTGownXZJ3W3AgkmXyvsGAhUaQrU\"]},\"src/interfaces/IPicocashVault.sol\":{\"keccak256\":\"0x95154158adfb063ef7de0890c61406184415f85f463ae1d6b199006730439777\",\"license\":\"Apache-2.0\",\"urls\":[\"bzz-raw://f3ea282a1b38826b252530099b74838ba4f32d04afaa85d53e0cf792d39677a4\",\"dweb:/ipfs/QmT7YvQq36HMEThTLFmDgVgHgEW5BbBx6ztw9jFRAzqVwm\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.35+commit.47b9dedd"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"address","name":"vault","type":"address","indexed":true},{"internalType":"address","name":"token","type":"address","indexed":true},{"internalType":"address","name":"operator","type":"address","indexed":true},{"internalType":"string","name":"name","type":"string","indexed":false},{"internalType":"string","name":"mintUrl","type":"string","indexed":false},{"internalType":"uint256","name":"rotationTimelock","type":"uint256","indexed":false},{"internalType":"uint16","name":"publishThresholdBps","type":"uint16","indexed":false},{"internalType":"uint64","name":"publishIntervalBlocks","type":"uint64","indexed":false},{"internalType":"uint256","name":"maxMeltFee","type":"uint256","indexed":false}],"type":"event","name":"VaultDeployed","anonymous":false},{"inputs":[{"internalType":"address","name":"token","type":"address"},{"internalType":"address","name":"operator","type":"address"},{"internalType":"uint256","name":"rotationTimelock","type":"uint256"},{"internalType":"uint16","name":"publishThresholdBps","type":"uint16"},{"internalType":"uint64","name":"publishIntervalBlocks","type":"uint64"},{"internalType":"uint256","name":"maxMeltFee","type":"uint256"},{"internalType":"string","name":"name","type":"string"},{"internalType":"string","name":"mintUrl","type":"string"}],"stateMutability":"nonpayable","type":"function","name":"deployVault","outputs":[{"internalType":"address","name":"vault","type":"address"}]},{"inputs":[{"internalType":"address","name":"vault","type":"address"}],"stateMutability":"view","type":"function","name":"isVault","outputs":[{"internalType":"bool","name":"","type":"bool"}]},{"inputs":[],"stateMutability":"view","type":"function","name":"vaultCount","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function","name":"vaults","outputs":[{"internalType":"address","name":"","type":"address"}]}],"devdoc":{"kind":"dev","methods":{},"version":1},"userdoc":{"kind":"user","methods":{"deployVault(address,address,uint256,uint16,uint64,uint256,string,string)":{"notice":"Deploy a vault. The caller pays gas; `operator` (the mint's         key) controls the vault from birth — the factory and the caller         retain nothing. The publication policy (at least one rule) is a         deploy-time commitment: `publishThresholdBps` (publish when the         backing drifts more than X bps) and/or `publishIntervalBlocks`         (publish at least every X blocks)."},"isVault(address)":{"notice":"True iff the address was deployed by this factory."},"vaults(uint256)":{"notice":"Every vault ever deployed, in order."}},"version":1}},"settings":{"remappings":["forge-std/=lib/forge-std/src/"],"optimizer":{"enabled":true,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"src/PicocashVaultFactory.sol":"PicocashVau